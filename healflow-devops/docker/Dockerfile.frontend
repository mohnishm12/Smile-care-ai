# =============================================================================
# HealFlow AI — Frontend Dockerfile (Next.js 15 Standalone)
# Multi-stage: deps → builder → nginx production runtime
# =============================================================================

# ---------- Dependencies Stage ----------
FROM node:22-alpine AS deps

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy only dependency files for layer caching
COPY healflow-frontend/package.json healflow-frontend/package-lock.json ./

RUN npm ci --only=production --legacy-peer-deps

# ---------- Builder Stage ----------
FROM node:22-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY healflow-frontend/ .

ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ---------- Production Stage (Nginx) ----------
FROM nginx:1.27-alpine AS production

ENV \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

# Install curl for health checks
RUN apk add --no-cache curl

# Copy built standalone output from builder
# Next.js standalone mode outputs to .next/standalone
COPY --from=builder /app/.next/standalone /app
COPY --from=builder /app/.next/static /app/.next/static
COPY --from=builder /app/public /app/public

# Copy nginx configuration
COPY healflow-devops/nginx/nginx.conf /etc/nginx/nginx.conf
COPY healflow-devops/nginx/default.conf /etc/nginx/conf.d/default.conf

# Create non-root user and set permissions
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    chown -R nextjs:nodejs /app /var/cache/nginx /var/run

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Drop privileges
USER nextjs

EXPOSE 3000

# Start nginx (which proxies to the Next.js server on port 3000 internally)
CMD ["nginx", "-g", "daemon off;"]