# =============================================================================
# HealFlow AI — Frontend Dockerfile (Next.js 15 Standalone)
# Multi-stage: builder (full deps, incl. devDeps needed by `next build`) →
# slim node runtime serving the standalone server directly on :3000.
# The reverse proxy / TLS termination is the separate top-level `nginx`
# service in docker-compose.yml — this image does not embed nginx.
# =============================================================================

# ---------- Builder Stage ----------
FROM node:22-alpine AS builder

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy only dependency files first for layer caching
COPY healflow-frontend/package.json healflow-frontend/package-lock.json ./

# Full install (incl. devDependencies) — `next build` needs typescript/eslint/etc.
RUN npm ci --legacy-peer-deps

COPY healflow-frontend/ .

# NEXT_PUBLIC_* values are inlined at build time. Empty (default) means the
# client uses same-origin URLs, which route through the nginx reverse proxy.
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_WS_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ---------- Production Stage (Node runtime, standalone server) ----------
FROM node:22-alpine AS production

ENV \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN apk add --no-cache curl

WORKDIR /app

# Next.js standalone mode outputs a self-contained server + pruned node_modules
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# Create non-root user and set permissions
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 && \
    chown -R nextjs:nodejs /app

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Drop privileges
USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
