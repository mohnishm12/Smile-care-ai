# =============================================================================
# HealFlow AI — Backend Dockerfile (FastAPI + Celery)
# Multi-stage: builder → production slim image
# =============================================================================

# ---------- Builder Stage ----------
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy only dependency files first for layer caching
COPY healflow-backend/pyproject.toml healflow-backend/setup.cfg ./

# Install runtime dependencies to a clean prefix
RUN pip install --no-cache-dir --user --upgrade pip && \
    pip install --no-cache-dir --user .

# Copy source and install the package
COPY healflow-backend/src ./src
RUN pip install --no-cache-dir --user .

# ---------- Production Stage ----------
FROM python:3.12-slim AS production

ENV \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# Install runtime system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r healflow && useradd -r -g healflow -d /app -s /sbin/nologin healflow

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /root/.local /usr/local
COPY healflow-backend/src ./src

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Drop privileges
USER healflow

# Expose FastAPI port
EXPOSE 8000

# Run with uvicorn
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--proxy-headers", "--forwarded-allow-ips", "*"]