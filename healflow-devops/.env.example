# =============================================================================
# HealFlow AI — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Application
APP_NAME=HealFlow AI
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healflow

# Redis
REDIS_PASSWORD=

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=change-me-in-production-use-a-real-encryption-key-32bytes

# AI assistant (chat auto-replies)
# Leave ANTHROPIC_API_KEY empty to use the built-in fallback responder.
AI_REPLY_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ENVIRONMENT=development

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Optional: AWS credentials for production
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=