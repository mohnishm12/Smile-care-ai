{
  "title": "Message Throughput",
  "version": 1,
  "editable": false,
  "panels": [
    {
      "title": "Messages Sent (by Channel)",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(messages_sent_total[5m])",
          "legendFormat": "{{channel}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "Delivery Success Rate",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(messages_delivered_total[5m]) / rate(messages_sent_total[5m])",
          "legendFormat": "Delivery rate"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "Webhook Processing Time",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(webhook_processing_seconds_bucket[5m]))",
          "legendFormat": "P95 webhook"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
    }
  ]
}